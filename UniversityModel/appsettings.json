{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {                             // 4.2 adding the jwt setting in appsetting.json
    "Key": "UniversityModel-SuperSecretKey-2026-MyProject",                    // the key we use for jwt signature
    "Issuer": "UniversityModel",                       //to check who has sent the token
    "Audience": "UniversityModelUsers",                   // to check whom the token is sent to
    "ExpireMinutes": 60                         //the time of expiration token
  },

  "AllowedHosts": "*"
}